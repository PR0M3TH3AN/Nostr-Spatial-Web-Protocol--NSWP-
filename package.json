{
  "name": "nswp",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @nswp/core && npm run build -w @nswp/cli && npm run build -w nswp-bridge && node scripts/build-sites.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/sdk && tsc -p packages/bridge && tsc -p sites",
    "gate": "node scripts/gate.mjs",
    "vectors": "tsx scripts/generate-vectors.ts",
    "vectors:check": "tsx scripts/generate-vectors.ts --check",
    "nswp": "tsx packages/cli/src/index.ts",
    "bridge": "tsx packages/bridge/src/index.ts",
    "previews": "node scripts/capture-previews.mjs",
    "deploy:sites": "node scripts/deploy-sites.mjs",
    "kits": "node scripts/kit-status.mjs",
    "release:all": "node scripts/release-all.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "build:engine": "node scripts/build-engine.mjs",
    "engine:check": "node scripts/build-engine.mjs --check",
    "build:godot": "node scripts/build-godot-example.mjs",
    "trial": "NODE_EXTRA_CA_CERTS=\"$HOME/.config/nswp/dev-https/cert.pem\" node",
    "relay": "node trials/stand-in-relay.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "iwer": "^2.8.0",
    "nostr-tools": "^2.26.1",
    "playwright-core": "^1.65.1",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "ws": "^8.23.0"
  }
}
