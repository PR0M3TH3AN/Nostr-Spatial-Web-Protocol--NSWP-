; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Foundry"
config/description="A small world made in Godot, to show the NSWP addon: an entry point, a door, and the way home."
run/main_scene="res://example/main.tscn"
boot_splash/bg_color=Color(0.024, 0.035, 0.055, 1)
boot_splash/show_image=false
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Nswp="*res://addons/nswp/nswp.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/nswp/plugin.cfg")

[nswp]

airlock="https://portal.bitblocks.network/go/"
signer="https://bitlogin.network/"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[xr]

shaders/enabled=true
